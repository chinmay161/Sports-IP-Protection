# Environment variables for the backend

# Database
DATABASE_URL=postgresql+asyncpg://sports_ip:sports_ip_dev@localhost:5432/sports_ip
POSTGRES_PASSWORD=sports_ip_dev

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# MinIO / S3
AWS_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=sports-ip-evidence
LIVE_BUCKET=sports-ip-live

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=video_fingerprints
MILVUS_REQUIRED=false

# Inside Docker these become:
# DATABASE_URL=postgresql+asyncpg://sports_ip:...@postgres:5432/sports_ip
# AWS_ENDPOINT_URL=http://minio:9000
# MILVUS_HOST=milvus

TEMP_ROOT=/tmp/sports-ip
WATERMARK_SECRET_KEY=
AWS_REGION=
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=
LIVE_STREAM_ENABLED=true
INBOUND_POLL_INTERVAL_S=15
INBOUND_MAX_SEGMENTS=5
ALLOW_REAL_CDN_REQUESTS=false

MAX_DOWNLOAD_BYTES=2147483648
GEOIP_DATABASE_PATH=
CRAWLER_MODE=mock
CRAWLER_DISCOVERY_MODE=hybrid
CRAWLER_WATCHLIST_URLS=
VISUAL_CRAWL_MAX_PAGES=50
VISUAL_CRAWL_MAX_IMAGES=100
VISUAL_CRAWL_MAX_CANDIDATES=25
VISUAL_PHASH_THRESHOLD=18
GEMINI_API_KEY=your_key_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json
GEMINI_ENABLED=true
VIDEO_INTELLIGENCE_ENABLED=true
